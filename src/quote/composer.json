{
    "name": "openteletry-demo/quote",
    "description": "Quote Service part of OpenTelemetry Demo",
    "license": "Apache-2.0",
    "require": {
        "php": ">= 8.3",
        "ext-json": "*",
        "ext-pcntl": "*",
        "monolog/monolog": "3.10.0",
        "open-telemetry/api": "1.9.0",
        "open-telemetry/sdk": "1.14.0",
        "open-telemetry/exporter-otlp": "1.4.0",
        "open-telemetry/opentelemetry-auto-slim": "1.4.0",
        "open-telemetry/detector-container": "1.3.0",
        "open-telemetry/opentelemetry-logger-monolog": "1.2.0",
        "guzzlehttp/guzzle": "7.11.0",
        "php-di/php-di": "7.1.1",
        "php-di/slim-bridge": "3.4.1",
        "php-http/guzzle7-adapter": "1.1.0",
        "react/http": "v1.11.0",
        "slim/psr7": "1.8.0",
        "slim/slim": "4.15.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
